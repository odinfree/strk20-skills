# Copy to .env, chmod 600 .env, then edit in your editor.
# Use your own HTTPS Starknet RPC v0.10 endpoint. Keep literal URLs single-quoted.
# No wallet signing key or viewing key belongs in this file.
RPC_URL='https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/REPLACE_ME'
CHAIN_ID=SN_SEPOLIA

# Starting allocation, not a guaranteed minimum. Leave RAM for the host OS.
PROVER_CPUS=12
PROVER_MEMORY=32g
PROVER_HOST_PORT=3000
